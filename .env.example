# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE CLIENT ID (for Google Sign-In Admin Auth):
# Created in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# AUTHORIZED ADMIN GOOGLE EMAILS (Comma-separated list of Google accounts permitted to administer events):
# Example: innovit.techies@gmail.com,admin@innovit.org
ADMIN_EMAILS="innovit.techies@gmail.com"

# GOOGLE SHEETS BACKEND STORAGE (Spreadsheet ID):
# Found in your Google Sheets URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEET_ID="your_google_spreadsheet_id_here"

# PORT: Server listening port (default: 3000)
PORT=3000

# EMERGENCY ADMIN PASSKEY (Fallback administrative secret key):
ADMIN_PASSWORD="innovit2026"

# ============================================================
# SUPABASE (Required for Vercel / multi-instance / 500 students)
# ============================================================
# Without these, the app falls back to a local JSON file which is NOT shared
# across serverless instances — parallel students will be lost on Vercel.
#
# 1. Create a free project at https://supabase.com
# 2. Run this in Supabase SQL Editor to create the participants table:
#      CREATE TABLE participants (
#        id TEXT PRIMARY KEY, event_id TEXT NOT NULL, event_code TEXT NOT NULL,
#        full_name TEXT NOT NULL, identifier TEXT NOT NULL, email TEXT NOT NULL DEFAULT '',
#        mobile TEXT NOT NULL DEFAULT '', college TEXT NOT NULL DEFAULT '', branch TEXT NOT NULL DEFAULT '',
#        year TEXT NOT NULL DEFAULT '', score INTEGER NOT NULL DEFAULT 0, total_questions INTEGER NOT NULL DEFAULT 0,
#        percentage NUMERIC(5,2) NOT NULL DEFAULT 0, duration_seconds INTEGER,
#        status TEXT NOT NULL DEFAULT 'in_progress', started_at TIMESTAMPTZ NOT NULL DEFAULT now(),
#        completed_at TIMESTAMPTZ, device_info TEXT NOT NULL DEFAULT '', answers JSONB NOT NULL DEFAULT '{}'::jsonb,
#        created_at TIMESTAMPTZ NOT NULL DEFAULT now()
#      );
#      ALTER TABLE participants ENABLE ROW LEVEL SECURITY;
# 3. Supabase > Settings > API: copy Project URL + service_role key
# 4. Add these two env vars in Vercel (Project > Settings > Environment Variables):
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-eyJ-key"

# ============================================================
# ADMIN ACCESS (credentials only YOU can use to view participants)
# ============================================================
# Set a strong ADMIN_PASSWORD in Vercel — this is the passkey to open the admin panel.
# Anyone who knows this password can see all participant data, so make it long & unique.
ADMIN_PASSWORD="innovit2026"

# Only the Google emails listed here can sign in to the admin panel via Google.
# Put YOUR email here (comma-separated for multiple). Remove the default.
ADMIN_EMAILS="innovit.techies@gmail.com"
