# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE CLIENT ID (for Google Sign-In Admin Auth):
# Created in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# AUTHORIZED ADMIN GOOGLE EMAILS (Comma-separated list of Google accounts permitted to administer events):
# Example: innovit.techies@gmail.com,admin@innovit.org
ADMIN_EMAILS="innovit.techies@gmail.com"

# GOOGLE SHEETS BACKEND STORAGE (Spreadsheet ID):
# Found in your Google Sheets URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEET_ID="your_google_spreadsheet_id_here"

# PORT: Server listening port (default: 3000)
PORT=3000

# EMERGENCY ADMIN PASSKEY (Fallback administrative secret key):
ADMIN_PASSWORD="innovit2026"

# ============================================================
# FIRESTORE (Required for Vercel / multi-instance / 500 students)
# ============================================================
# Without these, the app falls back to a local JSON file which is NOT shared
# across serverless instances — parallel students will be lost on Vercel.
#
# Create a service account key:
#   Firebase Console > Project Settings > Service Accounts > "Generate new private key"
# Then add these three env vars in Vercel (Project > Settings > Environment Variables):
FIREBASE_PROJECT_ID="gen-lang-client-0149541750"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@gen-lang-client-0149541750.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
